{
  "name": "tsp-boards",
  "version": "0.9.0",
  "private": true,
  "description": "Generator for TSP puzzle boards (map puzzle and incremental puzzle)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "data:download": "tsx scripts/build-data/download.ts",
    "data:build": "tsx scripts/build-data/build.ts",
    "font:build": "tsx scripts/build-font/build.ts"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "fflate": "0.8.3",
    "highs": "1.15.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "topojson-client": "3.1.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/fira-sans-condensed": "5.3.0",
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "mapshaper": "0.7.83",
    "opentype.js": "2.0.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
