{
  // Tests run in Node (Vitest) but may import UI modules, hence DOM types as well.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "cli/**/*.test.ts",
    "scripts/**/*.test.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "scripts/build-data/mapshaper.d.ts",
    "src/ui/env.d.ts"
  ]
}
