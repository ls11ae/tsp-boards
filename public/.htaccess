# Apache settings for the static TSP Boards site (see docs/deployment.md). Ignored elsewhere.

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType text/javascript .js .mjs
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # Hashed build files never change: cache them for a year.
  <FilesMatch "^.+-[A-Za-z0-9_-]{8}\.(js|css|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The page and the city data keep their names across updates: revalidate.
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # The service worker and the web app manifest: revalidate, so that updates arrive.
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/json application/wasm image/svg+xml
</IfModule>
