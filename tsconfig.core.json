{
  // Pure core: no DOM and no Node types, so it provably runs in browsers, workers and Node.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": [],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.core.tsbuildinfo"
  },
  "include": ["src/core/**/*.ts"],
  "exclude": ["src/core/**/*.test.ts"]
}
